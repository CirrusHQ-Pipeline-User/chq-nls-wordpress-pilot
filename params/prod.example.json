{
  "StackName": "nls-prod",
  "Region": "eu-west-2",
  "Tags": {
    "Project": "NLS",
    "Environment": "prod",
    "ManagedBy": "CloudFormation"
  },
  "Parameters": {
    "EnvironmentName": "nls-prod",
    "VpcCidr": "10.20.0.0/16",
    "PublicSubnet1Cidr": "10.20.0.0/24",
    "PublicSubnet2Cidr": "10.20.1.0/24",
    "PrivateSubnet1Cidr": "10.20.10.0/24",
    "PrivateSubnet2Cidr": "10.20.11.0/24",
    "CreateDataSubnets": "true",
    "DataSubnet1Cidr": "10.20.20.0/24",
    "DataSubnet2Cidr": "10.20.21.0/24",
    "NatGatewayMode": "PerAZ",
    "EnableFlowLogs": "true",
    "LogRetentionDays": "90",

    "AllowedIngressCidr": "0.0.0.0/0",
    "CertificateArn": "arn:aws:acm:eu-west-2:111111111111:certificate/REPLACE-ME",
    "HealthCheckPath": "/health",
    "WafRateLimit": "2000",
    "EnableWafLogging": "true",

    "AppPort": "80",
    "InstanceType": "t3.small",
    "RootVolumeSize": "30",
    "MinSize": "2",
    "MaxSize": "6",
    "DesiredCapacity": "2",
    "CpuTargetUtilization": "60",

    "CreateDatabase": "true",
    "DbEngine": "postgres",
    "DbEngineVersion": "",
    "DbInstanceClass": "db.t4g.medium",
    "DbAllocatedStorage": "50",
    "DbMaxAllocatedStorage": "200",
    "DbName": "appdb",
    "DbMasterUsername": "dbadmin",
    "DbMultiAZ": "true",
    "DbBackupRetentionDays": "14",
    "DbDeletionProtection": "true"
  }
}
